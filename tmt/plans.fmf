/run:
  summary: Run the testsuite
  discover:
    how: fmf
    filter: tag:-ci & tag:-compile
  execute:
    how: tmt
/run-ci:
  summary: Run the CI for the testsuite
  tag: [ci]
  discover:
    how: fmf
    filter: tag:-compile
  execute:
    how: tmt
/compile-test:
  summary: Test compilation on various architectures
  tag: [compile]
  discover:
    how: fmf
    filter: tag:compile
  execute:
    how: tmt
